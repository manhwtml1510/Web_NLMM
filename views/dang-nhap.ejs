<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng nhập - NLMM</title>
  <link rel="stylesheet" href="styles/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>

<div class="login-container">
  <div class="login-left">
    <form class="login-form" method="POST" action="/tai-khoan/kiem-tra-dang-nhap">
      <h1 class="login-title">Sign in to NLMM</h1>
      <div class="social-icons">
        <a href="#" class="social-circle">f</a>
        <a href="#" class="social-circle">G+</a>
        <a href="#" class="social-circle">in</a>
      </div>
      <p class="login-subtext">Hoặc đăng nhập bằng tài khoản email:</p>
      <input type="text" name="ten_tai_khoan" placeholder="Tên đăng nhập" class="login-input" required>
      <input type="password" name="mat_khau" placeholder="Mật khẩu" class="login-input" required>
      <button class="login-btn">ĐĂNG NHẬP</button>
      <p><a href="/fg_password">Quên mật khẩu?</a></p>

    </form>
  </div>
  <div class="login-right">
    <h1>Xin chào!</h1>
    <p>Hãy nhập thông tin cá nhân của bạn<br> để bắt đầu hành trình cùng chúng tôi</p>
    <button onclick="window.location.href='/register'">ĐĂNG KÝ</button>
  </div>
</div>


</body>
</html>
